<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#252920">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Blaster WA">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <title>Sign in — Blaster</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-stage">
  <main class="login-layout">
    <div class="login-brand-row">
      <span class="brand-mark">b.</span>
      <span class="brand-copy"><strong>BLASTER</strong><small>WHATSAPP CAMPAIGNS</small></span>
      <div class="language-switch login-language-switch" role="group" aria-label="Choose language">
        <button type="button" data-language-choice="id" aria-pressed="false">ID</button>
        <button type="button" data-language-choice="en" aria-pressed="false">EN</button>
      </div>
    </div>
    <section class="login-card">
      <div class="eyebrow">YOUR WORKSPACE</div>
      <h1>Welcome back<span>.</span></h1>
      <p class="login-subtitle">Sign in to continue to your campaign studio.</p>
      <% if (error) { %>
        <div class="login-error"><%= error %></div>
      <% } %>
      <form method="POST" action="/login" class="login-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="username">Username</label>
        <input id="username" name="username" placeholder="Your username" autocomplete="username" required>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="Your password" autocomplete="current-password" required>
        <button type="submit" class="legacy-primary login-submit">Sign in <span aria-hidden="true">↗</span></button>
      </form>
      <div class="login-footnote"><span></span> A considered space for customer communication.</div>
    </section>
    <footer class="login-footer"><span>BLASTER / PRIVATE WORKSPACE</span><span>INDONESIA · UTC+7</span></footer>
  </main>
  <script src="/js/i18n.js"></script>
</body>
</html>
