<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Login — WA Blaster</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  body { background:#0F1117; color:#F9FAFB; -webkit-font-smoothing:antialiased; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; }
</style>
</head>
<body class="min-h-screen flex items-center justify-center p-6">
  <form method="POST" action="/login" class="w-full max-w-sm bg-[#1A1D24] rounded-2xl p-6 space-y-4">
    <div class="text-center mb-2">
      <div class="w-12 h-12 rounded-2xl bg-[#10B981] mx-auto mb-3 flex items-center justify-center text-2xl">💬</div>
      <h1 class="text-xl font-semibold">WA Blaster</h1>
      <p class="text-sm text-gray-400 mt-1">Masuk ke akun Anda</p>
    </div>
    <% if (error) { %>
      <div class="bg-red-500/10 text-red-400 text-sm rounded-lg p-3"><%= error %></div>
    <% } %>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input name="username" placeholder="Username" required
      class="w-full bg-[#0F1117] border border-white/10 rounded-xl px-4 py-3 text-base">
    <input name="password" type="password" placeholder="Password" required
      class="w-full bg-[#0F1117] border border-white/10 rounded-xl px-4 py-3 text-base">
    <button type="submit" class="w-full bg-[#10B981] hover:bg-emerald-500 text-black font-semibold rounded-xl py-3">
      Masuk
    </button>
  </form>
</body>
</html>