<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#252920">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Blaster WA">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <title>Templates — Blaster</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="app-shell">
  <header class="topbar"><div class="topbar-inner">
    <a class="brand" href="/dashboard"><span class="brand-mark">b.</span><span class="brand-copy"><strong>BLASTER</strong><small>WHATSAPP CAMPAIGNS</small></span></a>
    <nav class="topnav" aria-label="Main navigation"><a class="topnav-link" href="/dashboard">Campaign studio</a><a class="topnav-link active" href="/templates">Templates</a><a class="topnav-link" href="/settings">Settings</a></nav>
    <div class="language-switch" role="group" aria-label="Choose language">
        <button type="button" data-language-choice="id" aria-pressed="false">ID</button>
        <button type="button" data-language-choice="en" aria-pressed="false">EN</button>
      </div>
    <div class="account-area"><span class="account-name" data-no-translate><%= username %></span><a href="/settings" class="status-pill"><span class="status-dot"></span><span>Account</span></a></div>
  </div></header>
  <main class="page-shell legacy-page-shell">
    <section class="page-intro"><div><div class="eyebrow">WORKSPACE <span> / </span> LIBRARY</div><h1>Message templates<span>.</span></h1><p>Reusable words, ready when you need them.</p></div></section>
    <div class="templates-layout">
      <section class="panel template-create-panel">
        <div class="panel-heading"><div class="section-number">+</div><div class="panel-heading-copy"><h2>Create a template</h2><p>Save a message you use more than once.</p></div></div>
        <form id="tmplForm" class="template-form">
          <label for="title" class="field-label">Template name</label>
          <input id="title" placeholder="e.g. Product announcement" required class="field-control">
          <label for="body" class="field-label">Message content</label>
          <textarea id="body" rows="7" placeholder="Hello {nama}, …" required class="field-control message-editor"></textarea>
          <p class="helper-note">Use variables such as <code>{nama}</code>, <code>{kota}</code>, or any column from your contact list.</p>
          <button type="submit" class="legacy-primary full-button">Save template <span aria-hidden="true">↗</span></button>
        </form>
      </section>
      <section class="panel template-library-panel">
        <div class="panel-heading"><div class="panel-heading-copy"><h2>Your library</h2><p><%= items.length %> saved template<%= items.length === 1 ? '' : 's' %></p></div><span class="history-count"><%= items.length %></span></div>
        <div class="template-list" id="list">
          <% if (!items.length) { %><div class="empty-history"><span class="empty-history-mark">—</span><p>No templates yet.</p><small>Your saved messages will appear here.</small></div><% } %>
          <% items.forEach(t => { %>
            <article class="template-item" data-id="<%= t.id %>">
              <div class="template-item-top"><div><div class="eyebrow">TEMPLATE <span> / </span> #<%= t.id %></div><h3 data-no-translate><%= t.title %></h3></div><button type="button" class="quiet-button delBtn">Delete</button></div>
              <p class="template-body-text" data-no-translate><%= t.body %></p>
              <div class="template-item-footer"><span>Saved message</span><button type="button" class="template-use-button" data-body="<%= t.body.replace(/"/g,'&quot;') %>">Use in campaign ↗</button></div>
            </article>
          <% }) %>
        </div>
      </section>
    </div>
    <footer class="page-footer"><span>BLASTER <span class="footer-separator">/</span> TEMPLATES</span><span>Write once. Use thoughtfully.</span></footer>
  </main>
  <script>window.CSRF = "<%= csrfToken %>";</script>
  <script src="/js/i18n.js"></script>
  <script>
    const form = document.getElementById('tmplForm');
    form.addEventListener('submit', async event => {
      event.preventDefault();
      const title = document.getElementById('title').value.trim();
      const body = document.getElementById('body').value.trim();
      if (!title || !body) return;
      const response = await fetch('/api/templates', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.CSRF }, body: JSON.stringify({ title, body }) });
      if (response.ok) location.reload(); else alert('Could not save the template.');
    });
    document.querySelectorAll('.delBtn').forEach(button => button.addEventListener('click', async () => {
      const id = button.closest('[data-id]').dataset.id;
      if (!confirm('Delete this template?')) return;
      const response = await fetch('/api/templates/' + id, { method: 'DELETE', headers: { 'X-CSRF-Token': window.CSRF } });
      if (response.ok) location.reload(); else alert('Could not delete the template.');
    }));
    document.querySelectorAll('.template-use-button').forEach(button => button.addEventListener('click', () => {
      try { sessionStorage.setItem('blasterDraft', (button.dataset.body || '').replace(/&quot;/g, '"')); } catch {}
      location.href = '/dashboard';
    }));
  </script>
</body>
</html>
