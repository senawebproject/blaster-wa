<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Template — WA Blaster</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  body { background:#0F1117; color:#F9FAFB; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; }
  .card { background:#1A1D24; border-radius:1rem; }
  input, textarea, button { font-size:16px; }
</style>
</head>
<body class="pb-24">
  <header class="sticky top-0 bg-[#0F1117]/90 backdrop-blur border-b border-white/10">
    <div class="max-w-md mx-auto px-4 py-3 font-semibold">Template Pesan</div>
  </header>

  <main class="max-w-md mx-auto px-4 py-4 space-y-4">
    <form id="tmplForm" class="card p-4 space-y-3">
      <input id="title" placeholder="Judul template (misal: Follow-up)" required
        class="w-full bg-[#0F1117] border border-white/10 rounded-xl px-3 py-3">
      <textarea id="body" rows="5" placeholder="Selamat pagi {nama}, ..." required
        class="w-full bg-[#0F1117] border border-white/10 rounded-xl px-3 py-3"></textarea>
      <div class="text-xs text-gray-400">Gunakan <code class="text-emerald-400">{nama}</code> untuk personalisasi.</div>
      <button type="submit" class="w-full bg-[#10B981] text-black font-semibold rounded-xl py-3">Simpan Template</button>
    </form>

    <div class="space-y-2" id="list">
      <% items.forEach(t => { %>
        <div class="card p-4" data-id="<%= t.id %>">
          <div class="flex justify-between items-start gap-2">
            <div class="flex-1">
              <div class="font-semibold"><%= t.title %></div>
              <div class="text-sm text-gray-400 whitespace-pre-wrap mt-1"><%= t.body %></div>
            </div>
            <button class="text-red-400 text-sm delBtn">Hapus</button>
          </div>
        </div>
      <% }) %>
    </div>
  </main>

  <nav class="fixed bottom-0 inset-x-0 bg-[#0F1117]/95 backdrop-blur border-t border-white/10">
    <div class="max-w-md mx-auto grid grid-cols-3 text-center text-xs">
      <a href="/dashboard" class="py-3 text-gray-400">Blaster</a>
      <a href="/templates" class="py-3 text-[#10B981] font-semibold">Template</a>
      <a href="/settings" class="py-3 text-gray-400">Settings</a>
    </div>
  </nav>

<script>window.CSRF = "<%= csrfToken %>";</script>
<script>
  const form = document.getElementById('tmplForm');
  form.addEventListener('submit', async e => {
    e.preventDefault();
    const title = document.getElementById('title').value.trim();
    const body = document.getElementById('body').value.trim();
    if (!title || !body) return;
    const res = await fetch('/api/templates', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.CSRF },
      body: JSON.stringify({ title, body })
    });
    if (res.ok) location.reload();
    else alert('Gagal simpan');
  });
  document.querySelectorAll('.delBtn').forEach(b => b.addEventListener('click', async () => {
    const id = b.closest('[data-id]').dataset.id;
    if (!confirm('Hapus template ini?')) return;
    const res = await fetch('/api/templates/' + id, {
      method: 'DELETE', headers: { 'X-CSRF-Token': window.CSRF }
    });
    if (res.ok) location.reload();
  }));
</script>
</body>
</html>