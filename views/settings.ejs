<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Settings — WA Blaster</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  body { background:#0F1117; color:#F9FAFB; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; }
  .card { background:#1A1D24; border-radius:1rem; }
  input, button { font-size:16px; }
</style>
</head>
<body class="pb-24">
  <header class="sticky top-0 bg-[#0F1117]/90 backdrop-blur border-b border-white/10 z-10">
    <div class="max-w-md mx-auto px-4 py-3 font-semibold">Settings</div>
  </header>

  <main class="max-w-md mx-auto px-4 py-4 space-y-4">
    <section class="card p-4 space-y-3">
      <div class="flex justify-between items-center">
        <h2 class="font-semibold">Status WhatsApp</h2>
        <span id="stateBadge" class="text-xs px-2 py-1 rounded-lg bg-white/10">—</span>
      </div>
      <div id="waInfo" class="text-sm text-gray-400">Memuat…</div>
      <div id="pairingBox" class="hidden bg-[#10B981]/10 border border-[#10B981]/40 rounded-xl p-4 text-center">
        <div class="text-xs text-emerald-400 mb-1">Kode Pairing Anda (berlaku 60 detik)</div>
        <div id="pairingCode" class="text-3xl font-mono tracking-widest text-emerald-400">————</div>
        <div id="countdown" class="text-xs text-gray-400 mt-2"></div>
        <div class="text-xs text-gray-400 mt-2 leading-relaxed">
          Buka WhatsApp → Perangkat Tertaut → Tautkan Perangkat → Tautkan dengan nomor telepon → masukkan kode.
        </div>
      </div>
    </section>

    <section class="card p-4 space-y-3">
      <h2 class="font-semibold">Ganti / Pairing Nomor</h2>
      <input id="phone" placeholder="Contoh: 08123456789" class="w-full bg-[#0F1117] border border-white/10 rounded-xl px-3 py-3">
      <button id="pairBtn" class="w-full bg-[#10B981] text-black font-semibold rounded-xl py-3">Generate Pairing Code</button>
    </section>

    <section class="card p-4 space-y-3">
      <h2 class="font-semibold">Ubah Password Akun</h2>
      <input type="password" id="oldPass" placeholder="Password Lama" class="w-full bg-[#0F1117] border border-white/10 rounded-xl px-3 py-3">
      <input type="password" id="newPass" placeholder="Password Baru" class="w-full bg-[#0F1117] border border-white/10 rounded-xl px-3 py-3">
      <button id="btnChangePass" class="w-full bg-blue-500 text-white font-semibold rounded-xl py-3">Simpan Password Baru</button>
    </section>

    <section class="card p-4 space-y-3">
      <h2 class="font-semibold">Disconnect</h2>
      <p class="text-sm text-gray-400">Putuskan sesi WhatsApp dari server. Anda perlu pairing ulang untuk kirim pesan.</p>
      <button id="disconnectBtn" class="w-full bg-red-500/80 rounded-xl py-3 font-semibold">Disconnect WhatsApp</button>
    </section>

    <form method="POST" action="/logout" class="w-full pt-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="w-full bg-white/5 rounded-xl py-3 text-gray-300 border border-white/10">Logout Akun</button>
    </form>
  </main>

  <nav class="fixed bottom-0 inset-x-0 bg-[#0F1117]/95 backdrop-blur border-t border-white/10">
    <div class="max-w-md mx-auto grid grid-cols-3 text-center text-xs">
      <a href="/dashboard" class="py-3 text-gray-400">Blaster</a>
      <a href="/templates" class="py-3 text-gray-400">Template</a>
      <a href="/settings" class="py-3 text-[#10B981] font-semibold">Settings</a>
    </div>
  </nav>

<script>window.CSRF = "<%= csrfToken %>";</script>
<script src="/js/settings.js"></script>
</body>
</html>
