<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#252920">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Blaster WA">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <title>Settings — Blaster</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="app-shell">
  <header class="topbar"><div class="topbar-inner">
    <a class="brand" href="/dashboard"><span class="brand-mark">b.</span><span class="brand-copy"><strong>BLASTER</strong><small>WHATSAPP CAMPAIGNS</small></span></a>
    <nav class="topnav" aria-label="Main navigation"><a class="topnav-link" href="/dashboard">Campaign studio</a><a class="topnav-link" href="/templates">Templates</a><a class="topnav-link active" href="/settings">Settings</a></nav>
    <div class="language-switch" role="group" aria-label="Choose language">
      <button type="button" data-language-choice="id" aria-pressed="false">ID</button>
      <button type="button" data-language-choice="en" aria-pressed="false">EN</button>
    </div>
    <div class="account-area"><span class="account-name" data-no-translate><%= username %></span><span class="status-pill"><span class="status-dot"></span><span>Account</span></span></div>
  </div></header>
  <main class="page-shell legacy-page-shell">
    <section class="page-intro"><div><div class="eyebrow">WORKSPACE <span> / </span> PREFERENCES</div><h1>Settings<span>.</span></h1><p>Manage the connection and security for your workspace.</p></div></section>
    <div class="settings-layout">
      <div class="settings-main-column">
        <section class="panel">
          <div class="panel-heading"><div class="section-number">01</div><div class="panel-heading-copy"><h2>WhatsApp connection</h2><p>Check the current linked device and connection status.</p></div><span id="stateBadge" class="settings-state-badge">—</span></div>
          <div id="waInfo" class="settings-info">Loading connection status…</div>
          <div id="pairingBox" class="pairing-panel hidden"><div class="eyebrow">DEVICE PAIRING</div><div class="pairing-label">Your pairing code</div><div id="pairingCode" class="pairing-code">————</div><div id="countdown" class="pairing-countdown"></div><p>On your phone, open WhatsApp → Linked devices → Link a device → Link with phone number, then enter this code.</p></div>
        </section>
        <section class="panel">
          <div class="panel-heading"><div class="section-number">02</div><div class="panel-heading-copy"><h2>Link a phone number</h2><p>Generate a pairing code for the WhatsApp account you want to use.</p></div></div>
          <div class="settings-form-row"><div class="settings-field"><label for="phone" class="field-label">Phone number</label><input id="phone" class="field-control" placeholder="e.g. 08123456789" inputmode="tel"></div><button id="pairBtn" type="button" class="legacy-primary settings-action">Generate code <span aria-hidden="true">↗</span></button></div>
        </section>
        <section class="panel">
          <div class="panel-heading"><div class="section-number">03</div><div class="panel-heading-copy"><h2>Change password</h2><p>Use a strong password that you do not reuse elsewhere.</p></div></div>
          <div class="settings-password-grid"><div><label class="field-label" for="oldPass">Current password</label><input type="password" id="oldPass" class="field-control" autocomplete="current-password"></div><div><label class="field-label" for="newPass">New password</label><input type="password" id="newPass" class="field-control" autocomplete="new-password"></div></div>
          <button id="btnChangePass" type="button" class="secondary-button settings-password-button">Save new password</button>
        </section>
        <section class="panel" aria-labelledby="pacingHeading">
          <div class="panel-heading"><div class="section-number">04</div><div class="panel-heading-copy"><h2 id="pacingHeading">Sending pace</h2><p>Choose a sending rhythm for new campaigns. Faster options carry more restriction risk.</p></div></div>
          <p class="pacing-warning">Only send to people who agreed to receive your messages. Timing cannot guarantee an account will avoid restrictions.</p>
          <p class="helper-note pacing-helper-note">These settings apply to new campaigns only; existing campaigns are not changed.</p>
          <form id="sendPacingForm" class="pacing-options">
            <label class="pacing-option">
              <input type="radio" name="pacingProfile" value="very_fast" <%= pacingProfile === 'very_fast' ? 'checked' : '' %>>
              <span class="pacing-option-copy"><strong>Ultra fast</strong><small>2–5 seconds between messages; pause 5–10 minutes after every 10 messages. Highest restriction risk.</small></span>
            </label>
            <label class="pacing-option">
              <input type="radio" name="pacingProfile" value="fast" <%= pacingProfile === 'fast' ? 'checked' : '' %>>
              <span class="pacing-option-copy"><strong>Fast</strong><small>5–10 seconds between messages; pause 5–10 minutes after every 10 messages.</small></span>
            </label>
            <label class="pacing-option">
              <input type="radio" name="pacingProfile" value="quick" <%= pacingProfile === 'quick' ? 'checked' : '' %>>
              <span class="pacing-option-copy"><strong>Quick</strong><small>10–15 seconds between messages; pause 3–5 minutes after every 15 messages.</small></span>
            </label>
            <label class="pacing-option">
              <input type="radio" name="pacingProfile" value="recommended" <%= pacingProfile === 'recommended' ? 'checked' : '' %>>
              <span class="pacing-option-copy"><strong>Recommended <span class="pacing-recommended-tag">RECOMMENDED</span></strong><small>15–45 seconds between messages; pause 2–5 minutes after every 20 messages. This is the current default.</small></span>
            </label>
            <label class="pacing-option">
              <input type="radio" name="pacingProfile" value="careful" <%= pacingProfile === 'careful' ? 'checked' : '' %>>
              <span class="pacing-option-copy"><strong>More cautious</strong><small>30–60 seconds between messages; pause 5–10 minutes after every 10 messages.</small></span>
            </label>
            <label class="pacing-option">
              <input type="radio" name="pacingProfile" value="slow" <%= pacingProfile === 'slow' ? 'checked' : '' %>>
              <span class="pacing-option-copy"><strong>Slow</strong><small>45–90 seconds between messages; pause 5–10 minutes after every 10 messages.</small></span>
            </label>
            <label class="pacing-option">
              <input type="radio" name="pacingProfile" value="very_careful" <%= pacingProfile === 'very_careful' ? 'checked' : '' %>>
              <span class="pacing-option-copy"><strong>Very cautious</strong><small>60–120 seconds between messages; pause 10–15 minutes after every 10 messages.</small></span>
            </label>
            <button id="savePacingBtn" type="submit" class="secondary-button settings-password-button">Save sending settings</button>
            <p id="pacingStatus" class="pacing-status" role="status" aria-live="polite"></p>
          </form>
        </section>
      </div>
      <aside class="settings-side-column">
        <section class="panel disconnect-panel"><div class="section-number danger-number">!</div><h2>Disconnect WhatsApp</h2><p>Disconnect the linked WhatsApp session on this server. You will need to pair again before sending campaigns.</p><button id="disconnectBtn" type="button" class="stop-button full-button">Disconnect device</button></section>
        <section class="panel account-panel"><div class="eyebrow">ACCOUNT</div><h2 data-no-translate><%= username %></h2><p>This workspace is private to your signed-in account.</p><form method="POST" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="logout-button">Sign out <span aria-hidden="true">↗</span></button></form></section>
      </aside>
    </div>
    <footer class="page-footer"><span>BLASTER <span class="footer-separator">/</span> SETTINGS</span><span>Keep your workspace secure.</span></footer>
  </main>
  <script>window.CSRF = "<%= csrfToken %>";</script>
  <script src="/js/i18n.js"></script>
  <script src="/js/settings.js"></script>
</body>
</html>
