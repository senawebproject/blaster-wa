<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#252920">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Blaster WA">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <title>Campaign studio — Blaster</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="app-shell">
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/dashboard" aria-label="Blaster dashboard">
        <span class="brand-mark">b.</span>
        <span class="brand-copy"><strong>BLASTER</strong><small>WHATSAPP CAMPAIGNS</small></span>
      </a>
      <nav class="topnav" aria-label="Main navigation">
        <a class="topnav-link active" href="/dashboard">Campaign studio</a>
        <a class="topnav-link" href="/templates">Templates</a>
        <a class="topnav-link" href="/settings">Settings</a>
      </nav>
      <div class="language-switch" role="group" aria-label="Choose language">
        <button type="button" data-language-choice="id" aria-pressed="false">ID</button>
        <button type="button" data-language-choice="en" aria-pressed="false">EN</button>
      </div>
      <div class="account-area">
        <span class="account-name" data-no-translate><%= username %></span>
        <a href="/settings" id="waBadge" class="status-pill is-checking"><span class="status-dot"></span><span>Checking WhatsApp</span></a>
      </div>
    </div>
  </header>

  <main class="page-shell">
    <section class="page-intro">
      <div>
        <div class="eyebrow">WORKSPACE <span> / </span> CAMPAIGNS</div>
        <h1>Campaign studio<span>.</span></h1>
        <p>Compose a message, choose your audience, and send it with care.</p>
      </div>
      <div class="intro-note"><span class="note-line"></span><span>Built for thoughtful outreach</span></div>
    </section>

    <div class="workspace-grid">
      <div class="main-column">
        <section class="panel" aria-labelledby="messageHeading">
          <div class="panel-heading">
            <div class="section-number">01</div>
            <div class="panel-heading-copy"><h2 id="messageHeading">Compose message</h2><p>Start from a saved template or write something new.</p></div>
          </div>
          <div class="field-block">
            <label class="field-label" for="templateSelect">Saved template <span>OPTIONAL</span></label>
            <select id="templateSelect" class="field-control">
              <option value="">Choose a template…</option>
              <% templates.forEach(t => { %>
                <option data-no-translate value="<%= t.id %>" data-body="<%= t.body.replace(/"/g,'&quot;') %>"><%= t.title %></option>
              <% }) %>
            </select>
          </div>
          <div class="field-block message-field">
            <div class="field-label-row"><label class="field-label" for="templateBody">Message</label><span id="charCount" class="character-count">0 characters</span></div>
            <textarea id="templateBody" rows="6" class="field-control message-editor" placeholder="Write your message here…"></textarea>
            <div class="editor-footer"><span>Personalize with <code>{nama}</code>, <code>{kota}</code>, and other contact columns.</span><a href="/templates">Manage templates <span aria-hidden="true">↗</span></a></div>
          </div>
        </section>

        <section class="panel" aria-labelledby="mediaHeading">
          <div class="panel-heading">
            <div class="section-number">02</div>
            <div class="panel-heading-copy"><h2 id="mediaHeading">Add an attachment</h2><p>Optional · Add a photo, video, PDF, or document to your message.</p></div>
            <span class="optional-tag">OPTIONAL</span>
          </div>
          <input type="file" id="mediaInput" class="visually-hidden" accept="image/*,video/mp4,audio/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip,.rar,.odt,.ods,.odp,.epub">
          <label for="mediaInput" id="mediaDropzone" class="dropzone">
            <span class="drop-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M4 15.5v3A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5v-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="drop-copy"><strong>Choose a file to attach</strong><small>Images, video, audio, PDF and common documents · Up to 16 MB</small></span>
            <span class="drop-action">Browse files</span>
          </label>
          <div id="mediaStatus" class="inline-status" role="status"></div>
          <div id="mediaSelected" class="media-selected hidden">
            <div id="mediaThumb" class="media-thumb"><span>FILE</span></div>
            <div class="media-file-copy"><strong id="mediaName" data-no-translate>—</strong><span id="mediaDetails" data-no-translate>—</span></div>
            <button type="button" id="removeMediaBtn" class="quiet-button" aria-label="Remove attachment">Remove</button>
          </div>
          <p class="helper-note">Images and videos appear with your caption. Other file types are sent as WhatsApp documents.</p>
        </section>

        <section class="panel" aria-labelledby="audienceHeading">
          <div class="panel-heading">
            <div class="section-number">03</div>
            <div class="panel-heading-copy"><h2 id="audienceHeading">Choose your audience</h2><p>Import contacts from a spreadsheet. Phone numbers are checked before sending.</p></div>
          </div>
          <input type="file" id="fileInput" class="visually-hidden" accept=".xlsx,.csv">
          <label for="fileInput" id="contactDropzone" class="dropzone contact-dropzone">
            <span class="drop-icon sheet-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="3" width="16" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M8 8h8M8 12h8M8 16h3m2 0h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </span>
            <span class="drop-copy"><strong>Upload your contact list</strong><small>CSV or Excel workbook · Include a phone number column</small></span>
            <span class="drop-action">Choose list</span>
          </label>
          <div id="uploadInfo" class="inline-status" role="status"></div>
          <div id="previewWrap" class="preview-wrap hidden">
            <div class="preview-topline"><strong>Contact preview</strong><span id="previewSummary"></span></div>
            <div class="table-scroll"><table class="contacts-table"><thead id="previewHead"></thead><tbody id="previewBody"></tbody></table></div>
          </div>
        </section>

        <section class="panel" aria-labelledby="deliveryHeading">
          <div class="panel-heading">
            <div class="section-number">04</div>
            <div class="panel-heading-copy"><h2 id="deliveryHeading">Delivery</h2><p>Send now or choose a time for this campaign.</p></div>
          </div>
          <div class="delivery-options">
            <label class="delivery-choice"><input type="radio" name="mode" value="immediate" checked><span class="choice-radio"></span><span class="choice-copy"><strong>Send now</strong><small>Start once you launch the campaign.</small></span></label>
            <label class="delivery-choice"><input type="radio" name="mode" value="scheduled"><span class="choice-radio"></span><span class="choice-copy"><strong>Schedule</strong><small>Queue the campaign for a later time.</small></span></label>
          </div>
          <div id="scheduleField" class="field-block schedule-field hidden"><label class="field-label" for="scheduledAt">Scheduled date and time</label><input type="datetime-local" id="scheduledAt" class="field-control"></div>
        </section>
      </div>

      <aside class="side-column">
        <section class="preview-panel">
          <div class="preview-panel-head"><div><div class="eyebrow">LIVE PREVIEW</div><h2>Message preview</h2></div><span class="preview-indicator"><span></span> DRAFT</span></div>
          <div class="chat-stage">
            <div class="chat-caption">WHATSAPP MESSAGE</div>
            <div class="chat-bubble"><p id="messagePreview">Your message will appear here as you write.</p><div id="previewMedia" class="preview-media hidden"></div><div class="bubble-meta"><span id="previewTime">now</span><span aria-label="Message sent">✓✓</span></div></div>
            <div class="preview-footnote">Preview shows the message structure. Contact variables are filled for each recipient.</div>
          </div>
          <div class="summary-list">
            <div><span>Audience</span><strong id="audienceSummary">No list uploaded</strong></div>
            <div><span>Attachment</span><strong id="attachmentSummary">None</strong></div>
            <div><span>Delivery</span><strong id="deliverySummary">Send now</strong></div>
          </div>
          <button id="startBtn" class="launch-button" type="button"><span>Launch campaign</span><span aria-hidden="true">↗</span></button>
          <p class="launch-note">Only message people who have agreed to receive your updates.</p>
        </section>

        <section id="progressCard" class="panel progress-panel hidden">
          <div class="panel-heading compact-heading"><div class="section-number progress-mark">↗</div><div class="panel-heading-copy"><h2>Campaign progress</h2><p id="progressText">Waiting to start…</p></div></div>
          <div class="progress-track"><div id="progressBar" class="progress-fill" style="width:0%"></div></div>
          <div class="progress-controls"><button id="pauseBtn" type="button" class="secondary-button">Pause</button><button id="resumeBtn" type="button" class="secondary-button">Resume</button><button id="stopBtn" type="button" class="stop-button">Stop</button></div>
          <a id="failedLink" href="#" class="failed-link hidden">Download failed contacts CSV ↗</a>
        </section>

        <section class="panel history-panel">
          <div class="panel-heading compact-heading"><div class="panel-heading-copy"><h2>Recent campaigns</h2><p>Your latest activity.</p></div><span class="history-count"><%= history.length %></span></div>
          <% if (!history.length) { %>
            <div class="empty-history"><span class="empty-history-mark">—</span><p>No campaigns yet.</p><small>Your campaign history will appear here.</small></div>
          <% } else { %>
            <div class="history-list">
              <% history.forEach(h => { %>
                <div class="history-row"><span class="history-status status-<%= h.status %>"></span><div class="history-copy"><strong>Campaign #<%= h.id %></strong><small><%= h.status %> · <%= h.mode === 'scheduled' ? 'Scheduled' : 'Immediate' %></small></div><div class="history-result"><strong><%= h.sent %>/<%= h.total %></strong><small>sent</small></div></div>
              <% }) %>
            </div>
          <% } %>
        </section>
      </aside>
    </div>
    <footer class="page-footer"><span>BLASTER <span class="footer-separator">/</span> CAMPAIGN STUDIO</span><span>Made with ♥ by Yusuf Zulkarnaen.</span></footer>
  </main>

  <script>window.CSRF = "<%= csrfToken %>";</script>
  <script src="/js/i18n.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
